{
  "name": "animegitproject",
  "private": true,
  "version": "0.1.0-beta",
  "description": "AnimeViewer desktop and web app",
  "author": {
    "name": "psy0n3",
    "email": "psy0n3@users.noreply.github.com"
  },
  "scripts": {
    "dev:front": "npm --prefix front run dev -- --host 127.0.0.1 --port 8555 --strictPort",
    "dev:back": "cross-env DISABLE_AUTH=true DISABLE_RATE_LIMIT=true PORT=3000 npm --prefix back start",
    "build": "npm --prefix front run build",
    "lint": "npm --prefix front run lint",
    "check:back": "npm --prefix back run check",
    "install:all": "npm install && npm install --prefix front && npm install --prefix back",
    "update:back": "git subtree pull --prefix=back https://github.com/FxxMorgan/anime1v-api main --squash",
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "electron": "npm run build && electron .",
    "build:electron": "npm run build && electron-builder --mac",
    "build:electron:mac": "npm run build && electron-builder --mac",
    "build:electron:win": "npm run build && electron-builder --win",
    "build:electron:linux": "npm run build && electron-builder --linux",
    "build:electron:all": "npm run build && electron-builder --mac --win --linux --arm64 --x64"
  },
  "main": "electron/main.js",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1"
  }
}
